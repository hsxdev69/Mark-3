<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <!-- CloudStream Video Player Fragment Container (16:9 Inline in Portrait, Fullscreen in Landscape) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Unavailable Server Overlay (Keeps player screen open, lets user switch servers) -->
    <LinearLayout
        android:id="@+id/player_unavailable_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E60A0A0C"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/nav_host_fragment"
        app:layout_constraintEnd_toEndOf="@id/nav_host_fragment"
        app:layout_constraintTop_toTopOf="@id/nav_host_fragment"
        app:layout_constraintBottom_toBottomOf="@id/nav_host_fragment">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_baseline_warning_24"
            app:tint="#F59E0B" />

        <TextView
            android:id="@+id/player_unavailable_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/manrope_bold"
            android:text="The Movie is not available this server plese switch another"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Unified Synchronized Skeleton Shimmer Loading View (Shown while metadata & stream generator load) -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/player_skeleton_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0A0A0C"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.25"
        app:shimmer_duration="1000"
        app:shimmer_highlight_alpha="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nav_host_fragment"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="48dp">

                <!-- Title Placeholder -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- Metadata Row (Year, Rating, Type) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="54dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="72dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_skeleton_pill" />
                </LinearLayout>

                <!-- Streaming Servers Label -->
                <View
                    android:layout_width="130dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- Streaming Servers 4 Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <View
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_skeleton_pill" />
                </LinearLayout>

                <!-- Download Button Bar Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- Overview Synopsis Lines Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <View
                    android:layout_width="210dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- Related Movies Label Placeholder -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- 2-Column Vertical Grid Posters Shimmer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="6dp"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Portrait Details, Server Switcher & Episodes Section directly beneath Inline Player -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/player_details_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0A0A0C"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nav_host_fragment"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="48dp">

            <!-- Title & Metadata -->
            <TextView
                android:id="@+id/inline_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Movie Title" />

            <TextView
                android:id="@+id/inline_player_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9E9EA8"
                android:textSize="13sp"
                tools:text="2024 • Action, Adventure • 4K UHD" />

            <!-- SERVER SWITCHING TABS: Mark 1, Mark 2, Mark 3, Mark 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="STREAMING SERVERS"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/server_tabs_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Mark 1 Tab -->
                    <TextView
                        android:id="@+id/server_tab_mark_1"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_server_tab_active"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Mark 1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Mark 2 Tab -->
                    <TextView
                        android:id="@+id/server_tab_mark_2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_server_tab_inactive"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Mark 2"
                        android:textColor="#B0B0C0"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Mark 3 Tab -->
                    <TextView
                        android:id="@+id/server_tab_mark_3"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_server_tab_inactive"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Mark 3"
                        android:textColor="#B0B0C0"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Mark 4 Tab -->
                    <TextView
                        android:id="@+id/server_tab_mark_4"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_server_tab_inactive"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Mark 4"
                        android:textColor="#B0B0C0"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- DOWNLOAD OPTION BUTTON -->
            <LinearLayout
                android:id="@+id/inline_download_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_download_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/inline_download_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/netflix_download"
                    android:layout_marginEnd="8dp"
                    app:tint="#000000" />

                <TextView
                    android:id="@+id/inline_download_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Overview Synopsis -->
            <TextView
                android:id="@+id/inline_player_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#C8C8D4"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                tools:text="Overview synopsis goes here." />

            <!-- STAR CAST SECTION -->
            <LinearLayout
                android:id="@+id/inline_cast_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="TOP CAST"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inline_cast_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_inline_cast" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="#1AFFFFFF" />

            <!-- SEASONS SELECTOR (Tabs for Season 1, Season 2, etc.) -->
            <LinearLayout
                android:id="@+id/inline_seasons_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/inline_episodes_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/episodes" />

                <HorizontalScrollView
                    android:id="@+id/inline_seasons_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/inline_seasons_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Clean Vertical Episode List with Thumbnails -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inline_episodes_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_inline_episode" />
            </LinearLayout>

            <!-- RELATED MOVIES SECTION (Vertical Group of Two) -->
            <LinearLayout
                android:id="@+id/inline_related_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="MORE LIKE THIS"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <!-- 2-Column Vertical Grid with Increased Poster Size -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inline_related_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_inline_related" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
